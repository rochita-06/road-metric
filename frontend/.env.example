# Enable the Google Maps JavaScript API and billing for your Google Cloud project,
# then put the browser-restricted API key in frontend/.env.local.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Set this to the deployed Render API URL in Vercel; local development defaults to 127.0.0.1:8000.
VITE_API_BASE_URL=https://your-road-metric-api.onrender.com